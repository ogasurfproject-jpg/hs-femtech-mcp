{
  // hs-femtech-mcp  /  フェムCP v0.3 (P1)
  // 独立worker。KV で永続化(段階導入)。
  // アカウントは HORIZON SHIELD 側(c15ff64a / oga.surf.project@gmail.com)。
  // deploy 前に必ず: npx wrangler whoami で c15ff64a を確認。
  "name": "hs-femtech-mcp",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  "account_id": "c15ff64aba400e541853dec1fbe5e76a",

  // ★2026-08-27 追加: 検証の扉(hs-verify-gate)から届く公開エンドポイントとして
  //   femtech.horizonshield.dev を張る。jidec/ledger と同一の custom_domain:true 作法(実測3本)。
  //   - ダッシュボードの Add Domain/Route は "No zones match horizonshield.dev" で弾くが、
  //     これは画面側の不具合。wrangler は API を直接叩くので、ここに書けば通る。
  //   - custom_domain:true なら wrangler が DNS レコードごと作る。pattern に /* は付けない。
  //   - 扉は「対象が自ゾーン(horizonshield.dev)のとき」Deno中継(RELAY_URL)経由で公開エッジ測定
  //     する設計。femtech をこのゾーンに置くと、扉が既に自己検証で使っている生きた経路に乗る。
  //     workers.dev 直叩きの同一アカウント404を回避できる。
  //   ★workers_dev は true を必ず残すこと。routes を足すと wrangler の既定が false になり
  //     hs-femtech-mcp.oga-surf-project.workers.dev が落ちる。README/server.json/既存の検証が
  //     このURLを指しているので、新ドメインは「追加」であって「移行」ではない。
  "workers_dev": true,
  "observability": { "enabled": true, "logs": { "enabled": true } },

  "kv_namespaces": [
    { "binding": "FEMTECH_KV", "id": "a7d37d3fa02b462ba239dab1dd70aaf2" }
  ],

  "routes": [
    { "pattern": "femtech.horizonshield.dev", "custom_domain": true }
  ]

  // 公開 register_source の永続化を許可する場合のみ(既定オフ推奨):
  // "vars": { "FEMTECH_PUBLIC_WRITE": "1" }
}
